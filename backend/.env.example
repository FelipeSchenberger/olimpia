# Base de datos (PostgreSQL vía Supabase o local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret JWT para autenticación (Supabase u otro proveedor)
SUPABASE_JWT_SECRET="your_jwt_secret_here"

# MercadoPago (Credenciales de Integración)
# Podés obtenerlas en: https://www.mercadopago.com/developers/panel/credentials
MP_ACCESS_TOKEN="TEST-your-access-token-here"
MP_PUBLIC_KEY="TEST-your-public-key-here"

# Opcionales
# FRONTEND_URL="http://localhost:4200"
# BACKEND_URL="https://tu-backend.ngrok-free.app"
